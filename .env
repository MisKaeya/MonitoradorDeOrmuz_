# Modo local em uma unica maquina com Docker Desktop.
# Dentro de containers, 127.0.0.1 aponta para o proprio container.
# Use host.docker.internal para acessar as portas publicadas no host.
MAQUINA_TORRES_IP=host.docker.internal
MAQUINA_BROKERS_IP=host.docker.internal
MAQUINA_WEB_IP=host.docker.internal
